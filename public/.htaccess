Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Arquivos e pastas que existem (CSS, JS, imagens) são servidos direto
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo o resto passa pelo front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>
